# Copy to .env in the project root. Restart the backend after changes.
DATABASE_PATH=backend/data/agribovix.db
FRONTEND_ORIGIN=http://127.0.0.1:3000
COOKIE_SECURE=false
# Choose gemini, openai, or adapter. Keep keys only in the untracked .env file.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional OpenAI provider (not called when gemini is selected).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Set AI_PROVIDER=adapter to use the private HTTP adapters below instead.
# Optional private HTTP model adapters, configured separately for each workspace.
# Keep keys here on the server. Never put secrets in VITE_ variables.
AGRIVISION_MODEL_URL=
AGRIVISION_MODEL_KEY=
PASHUVISION_MODEL_URL=
PASHUVISION_MODEL_KEY=
AGRIVISION_ASSISTANT_URL=
AGRIVISION_ASSISTANT_KEY=
PASHUVISION_ASSISTANT_URL=
PASHUVISION_ASSISTANT_KEY=
